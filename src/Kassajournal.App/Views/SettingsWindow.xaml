<Window x:Class="Kassajournal.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Kassajournal.App.Views"
        Title="Einstellungen – Kassajournal &amp; IVB"
        Height="820" Width="620" MinHeight="700" MinWidth="560"
        Background="{StaticResource BrushBackground}"
        FontFamily="{StaticResource AppFont}"
        WindowStartupLocation="CenterOwner">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
        <StackPanel>
            <TextBlock Text="Datenbank-Zugangsdaten" Style="{StaticResource TitleText}" Margin="0,0,0,4" />
            <TextBlock Text="Kassajournal und IVB verwenden zwei komplett getrennte Datenbanken. Beide Verbindungen laufen verschlüsselt (TLS/SSL); die Zugangsdaten werden nur lokal, verschlüsselt an dieses Benutzerkonto gebunden, gespeichert."
                       Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,20" />

            <views:DatabaseConnectionSettingsView DataContext="{Binding Kassajournal}" Margin="0,0,0,20" />
            <views:DatabaseConnectionSettingsView DataContext="{Binding Ivb}" Margin="0,0,0,20" />

            <Button Content="Schließen" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                    Padding="24,10" Click="Schliessen_Click" />
        </StackPanel>
    </ScrollViewer>
</Window>
