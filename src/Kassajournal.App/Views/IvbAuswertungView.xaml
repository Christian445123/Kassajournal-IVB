<UserControl x:Class="Kassajournal.App.Views.IvbAuswertungView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Kassajournal.App.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="Auswertung" Style="{StaticResource TitleText}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <Button Content="◀" Style="{StaticResource SecondaryButton}" Padding="10,4" Command="{Binding VorJahrCommand}" />
                    <TextBlock Text="{Binding Jahr}" FontSize="16" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center" />
                    <Button Content="▶" Style="{StaticResource SecondaryButton}" Padding="10,4" Command="{Binding NaechstesJahrCommand}" />
                </StackPanel>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Monate}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:KassaMonatsZeileViewModel}">
                        <Border Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,0,0,6" Cursor="Hand"
                                MouseLeftButtonUp="MonatZeile_Click" Tag="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Summe, StringFormat={}{0:N2} €}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0" Background="{StaticResource BrushPrimary}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Gesamtumsatz" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Gesamtumsatz, StringFormat={}{0:N2} €}" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
