<UserControl x:Class="Kassajournal.App.Views.HeuteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Kassajournal.App.ViewModels"
             xmlns:views="clr-namespace:Kassajournal.App.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1150" HorizontalAlignment="Left">

            <TextBlock Text="Heute" Style="{StaticResource TitleText}" />
            <TextBlock Text="{Binding HeutigesDatum}" FontSize="16" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,30" />

            <!-- Kassajournal -->
            <TextBlock Text="Kassajournal" Style="{StaticResource SectionTitleText}" FontSize="19" Margin="0,0,0,12" />
            <ContentControl Content="{Binding KassaHeute}" Margin="0,0,0,32">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:DayEntryViewModel}">
                        <views:DayEntryView />
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>

            <!-- IVB -->
            <TextBlock Text="IVB" Style="{StaticResource SectionTitleText}" FontSize="19" Margin="0,0,0,12" />
            <Border Style="{StaticResource CardBorder}" Padding="20,16">
                <ContentControl Content="{Binding IvbHeute}">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:IvbDayRowViewModel}">
                            <views:IvbDayRowView />
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
