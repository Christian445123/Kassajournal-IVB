<UserControl x:Class="Kassajournal.App.Views.KassaModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Kassajournal.App.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Kassajournal" Style="{StaticResource TitleText}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                <Button Content="◀" Style="{StaticResource SecondaryButton}" Padding="10,4" Command="{Binding VorJahrCommand}" />
                <TextBlock Text="{Binding Jahr}" FontSize="16" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center" />
                <Button Content="▶" Style="{StaticResource SecondaryButton}" Padding="10,4" Command="{Binding NaechstesJahrCommand}" />
            </StackPanel>
        </StackPanel>

        <TabControl x:Name="Tabs" Grid.Row="1" Background="Transparent" BorderThickness="0"
                    SelectionChanged="Tabs_SelectionChanged" SelectedIndex="{Binding SelectedTabIndex, Mode=OneWay}">
            <TabItem DataContext="{Binding Monate[0]}" Header="{Binding TabHeader}"><views:KassaMonthView /></TabItem>
            <TabItem DataContext="{Binding Monate[1]}" Header="{Binding TabHeader}"><views:KassaMonthView /></TabItem>
            <TabItem DataContext="{Binding Monate[2]}" Header="{Binding TabHeader}"><views:KassaMonthView /></TabItem>
            <TabItem DataContext="{Binding Monate[3]}" Header="{Binding TabHeader}"><views:KassaMonthView /></TabItem>
            <TabItem DataContext="{Binding Monate[4]}" Header="{Binding TabHeader}"><views:KassaMonthView /></TabItem>
            <TabItem DataContext="{Binding Monate[5]}" Header="{Binding TabHeader}"><views:KassaMonthView /></TabItem>
            <TabItem DataContext="{Binding Monate[6]}" Header="{Binding TabHeader}"><views:KassaMonthView /></TabItem>
            <TabItem DataContext="{Binding Monate[7]}" Header="{Binding TabHeader}"><views:KassaMonthView /></TabItem>
            <TabItem DataContext="{Binding Monate[8]}" Header="{Binding TabHeader}"><views:KassaMonthView /></TabItem>
            <TabItem DataContext="{Binding Monate[9]}" Header="{Binding TabHeader}"><views:KassaMonthView /></TabItem>
            <TabItem DataContext="{Binding Monate[10]}" Header="{Binding TabHeader}"><views:KassaMonthView /></TabItem>
            <TabItem DataContext="{Binding Monate[11]}" Header="{Binding TabHeader}"><views:KassaMonthView /></TabItem>
            <TabItem DataContext="{Binding Auswertung}" Header="Auswertung"><views:KassaAuswertungView /></TabItem>
            <TabItem DataContext="{Binding Vergleich}" Header="Vergleich"><views:KassaVergleichView /></TabItem>
        </TabControl>
    </Grid>
</UserControl>
