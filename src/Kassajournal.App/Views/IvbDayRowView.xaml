<UserControl x:Class="Kassajournal.App.Views.IvbDayRowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Eine Tageszeile im IVB-Journal: Wochentag, Datum, täglicher Umsatz, Feiertags-Häkchen.
         Wird sowohl im Wochenraster (IvbMonthView) als auch auf der "Heute"-Seite verwendet. -->
    <Border Padding="0,6">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IstHeute}" Value="True">
                        <Setter Property="Background" Value="#F4F6F8" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding Wochentag}" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" VerticalAlignment="Center" />

            <TextBox Grid.Column="2" Style="{StaticResource AmountTextBox}" Width="140" HorizontalAlignment="Left"
                     Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsEditable}"
                     LostFocus="AmountTextBox_LostFocus" />

            <CheckBox Grid.Column="3" Content="Feiertag" VerticalAlignment="Center"
                      IsChecked="{Binding IsFeiertag}" />

            <TextBlock Grid.Column="4" Text="{Binding StatusMessage}" FontSize="11"
                       Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
    </Border>
</UserControl>
