<UserControl x:Class="Kassajournal.App.Views.IvbMonthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Kassajournal.App.ViewModels"
             xmlns:views="clr-namespace:Kassajournal.App.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,14" Background="{StaticResource BrushPrimary}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Monatssumme" FontSize="15" Foreground="White" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding MonatsSumme, StringFormat={}{0:N2} €}" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Wochen}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:IvbWeekGroupViewModel}">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="16,12">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Tage}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:IvbDayRowViewModel}">
                                            <views:IvbDayRowView />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,8,0,8" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Wochensumme" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                    <TextBlock Grid.Column="1" Text="{Binding WochenSumme, StringFormat={}{0:N2} €}" FontWeight="Bold" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
