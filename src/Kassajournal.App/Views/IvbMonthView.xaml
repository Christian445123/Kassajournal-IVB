<UserControl x:Class="Kassajournal.App.Views.IvbMonthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Kassajournal.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,14" Background="{StaticResource BrushPrimary}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Monatssumme" FontSize="15" Foreground="White" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding MonatsSumme, StringFormat={}{0:N2} €}" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Wochen}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:IvbWeekGroupViewModel}">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="16,12">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Tage}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:IvbDayRowViewModel}">
                                            <Border Padding="0,6">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IstHeute}" Value="True">
                                                                <Setter Property="Background" Value="#F4F6F8" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="160" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Wochentag}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" VerticalAlignment="Center" />

                                                    <TextBox Grid.Column="2" Style="{StaticResource AmountTextBox}" Width="140" HorizontalAlignment="Left"
                                                             Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                                                             IsEnabled="{Binding IsEditable}"
                                                             LostFocus="AmountTextBox_LostFocus" />

                                                    <CheckBox Grid.Column="3" Content="Feiertag" VerticalAlignment="Center"
                                                              IsChecked="{Binding IsFeiertag}" />

                                                    <TextBlock Grid.Column="4" Text="{Binding StatusMessage}" FontSize="11"
                                                               Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,8,0,8" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Wochensumme" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                    <TextBlock Grid.Column="1" Text="{Binding WochenSumme, StringFormat={}{0:N2} €}" FontWeight="Bold" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
