<UserControl x:Class="Kassajournal.App.Views.MonthOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Kassajournal.App.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">

            <TextBlock Text="{Binding MonatsName}" Style="{StaticResource TitleText}" Margin="0,0,0,20" />

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Anfangssaldo" Style="{StaticResource SectionTitleText}" />
                        <Grid>
                            <TextBlock Text="{Binding Anfangssaldo, StringFormat={}{0:N2} €}" FontSize="20" FontWeight="SemiBold"
                                       Visibility="{Binding IsEditingAnfangssaldo, Converter={StaticResource InverseBoolToVisibility}}"
                                       MouseLeftButtonUp="Anfangssaldo_Click" Cursor="Hand" ToolTip="Klicken zum Bearbeiten" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsEditingAnfangssaldo, Converter={StaticResource BoolToVisibility}}">
                                <TextBox Width="100" Style="{StaticResource AmountTextBox}" Text="{Binding AnfangssaldoText}" />
                                <Button Content="✓" Width="34" Margin="6,0,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding AnfangssaldoSpeichernCommand}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Summe Soll" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding SummeSoll, StringFormat={}{0:N2} €}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource BrushSoll}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Summe Haben" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding SummeHaben, StringFormat={}{0:N2} €}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource BrushHaben}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Saldo (Kassenstand)" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding Saldo, StringFormat={}{0:N2} €}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Tage in diesem Monat" Style="{StaticResource SectionTitleText}" Margin="4,10,0,8" />

            <ItemsControl ItemsSource="{Binding Tage}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DayRowViewModel}">
                        <Border Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,0,0,8"
                                MouseLeftButtonUp="TagRow_Click" Cursor="Hand" Tag="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding DateDisplay}" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding SollSumme, StringFormat={}{0:N2} €}" Foreground="{StaticResource BrushSoll}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="{Binding HabenSumme, StringFormat={}{0:N2} €}" Foreground="{StaticResource BrushHaben}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="✓ OK" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushSoll}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IstAusgeglichen}" Value="False">
                                                    <Setter Property="Text" Value="⚠ Diff." />
                                                    <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Noch keine Buchungen in diesem Monat." Foreground="{StaticResource BrushTextSecondary}"
                       Visibility="{Binding Tage.Count, Converter={StaticResource CountToVisibility}}" Margin="4,10,0,0" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
