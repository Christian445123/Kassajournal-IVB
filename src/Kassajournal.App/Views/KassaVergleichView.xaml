<UserControl x:Class="Kassajournal.App.Views.KassaVergleichView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Kassajournal.App.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="Vergleich" Style="{StaticResource TitleText}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBox Width="70" Style="{StaticResource AmountTextBox}" FontSize="14" Padding="6,5"
                             Text="{Binding JahrA}" TextAlignment="Center" />
                    <TextBlock Text="vs." Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" />
                    <TextBox Width="70" Style="{StaticResource AmountTextBox}" FontSize="14" Padding="6,5"
                             Text="{Binding JahrB}" TextAlignment="Center" />
                    <Button Content="Vergleichen" Style="{StaticResource PrimaryButton}" Margin="14,0,0,0"
                            Command="{Binding NeuLadenCommand}" />
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="0" Text="Monat" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Grid.Column="1" Text="Jahr A" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="Jahr B" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="Unterschied" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="%" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Zeilen}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:KassaVergleichZeileViewModel}">
                        <Border Style="{StaticResource CardBorder}" Padding="16,10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding MonatsName}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding JahrA, StringFormat={}{0:N2} €}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding JahrB, StringFormat={}{0:N2} €}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Unterschied, StringFormat={}{0:N2} €}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource BrushSoll}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Unterschied, Converter={StaticResource NegativeToBool}}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="4" Text="{Binding ProzentVeraenderung, StringFormat={}{0:N1}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
