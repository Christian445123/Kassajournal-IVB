<UserControl x:Class="Kassajournal.App.Views.DatabaseConnectionSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource CardBorder}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="{Binding Titel}" FontSize="17" FontWeight="SemiBold" />
                <Border Background="#DFF3E6" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding IsConfigured, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="verbunden" FontSize="11" Foreground="{StaticResource BrushSoll}" />
                </Border>
            </StackPanel>
            <TextBlock Text="Diese Zugangsdaten gelten nur für diesen Bereich - Daten werden nie mit dem anderen Bereich vermischt."
                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,14" TextWrapping="Wrap" />

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Datenbank-Typ" Style="{StaticResource SectionTitleText}" />
                    <ComboBox ItemsSource="{Binding VerfuegbareEngines}" SelectedItem="{Binding Engine}" Padding="8,6" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Port" Style="{StaticResource SectionTitleText}" />
                    <TextBox Text="{Binding Port}" Padding="8,6" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Server / Host" Style="{StaticResource SectionTitleText}" />
                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
            </StackPanel>

            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Datenbankname" Style="{StaticResource SectionTitleText}" />
                <TextBox Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
            </StackPanel>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Benutzername" Style="{StaticResource SectionTitleText}" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Passwort" Style="{StaticResource SectionTitleText}" />
                    <PasswordBox x:Name="PasswordBox" Padding="8,6" PasswordChanged="PasswordBox_PasswordChanged" />
                </StackPanel>
            </Grid>

            <CheckBox Content="Verschlüsselte Verbindung erzwingen (TLS/SSL) - empfohlen" IsChecked="{Binding RequireEncryption}" Margin="0,4,0,14" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding TestStatusMessage}" VerticalAlignment="Center" FontSize="12"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TestWasSuccessful}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource BrushSoll}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="1" Content="Verbindung testen" Style="{StaticResource SecondaryButton}"
                        Command="{Binding VerbindungTestenCommand}" Margin="0,0,10,0" />
                <Button Grid.Column="2" Content="Speichern" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SpeichernCommand}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
