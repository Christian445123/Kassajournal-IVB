<Window x:Class="Kassajournal.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Kassajournal.App.Views"
        Title="Kassajournal &amp; IVB"
        Height="860" Width="1360" MinHeight="680" MinWidth="1080"
        Background="{StaticResource BrushBackground}"
        FontFamily="{StaticResource AppFont}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kopfleiste: Modul-Umschalter -->
        <Border Grid.Row="0" Background="{StaticResource BrushSidebar}">
            <Grid Margin="24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,28,0">
                    <TextBlock Text="Kassajournal &amp; IVB" Foreground="White" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="{Binding AppVersion, StringFormat=Version {0}}" Foreground="#8FA3B8" FontSize="11" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Kassajournal" Command="{Binding ZeigeKassajournalCommand}" Padding="20,10" Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="Foreground" Value="#C9D6E3" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IstKassajournalAktiv}" Value="True">
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="IVB" Command="{Binding ZeigeIvbCommand}" Padding="20,10">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="Foreground" Value="#C9D6E3" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IstIvbAktiv}" Value="True">
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Border Grid.Column="3" Background="#1E4165" CornerRadius="8" Padding="12,8" Margin="0,0,12,0"
                        Visibility="{Binding UpdateVerfuegbar, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding UpdateHinweis}" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Content="Aktualisieren" Style="{StaticResource SecondaryButton}" Foreground="White" Padding="10,4"
                                Command="{Binding UpdateInstallierenCommand}" />
                    </StackPanel>
                </Border>

                <Button Grid.Column="4" Content="⚙️ Einstellungen" Style="{StaticResource SecondaryButton}"
                        Foreground="#C9D6E3" BorderThickness="0" Click="Einstellungen_Click" />
            </Grid>
        </Border>

        <!-- Inhalt: genau ein Modul sichtbar -->
        <Grid Grid.Row="1" Margin="32">
            <views:KassaModuleView DataContext="{Binding Kassajournal}"
                                    Visibility="{Binding DataContext.IstKassajournalAktiv, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
            <views:IvbModuleView DataContext="{Binding Ivb}"
                                  Visibility="{Binding DataContext.IstIvbAktiv, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</Window>
